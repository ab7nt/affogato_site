# Конфигурация деплоя на хостинг (reg.ru). Скопируй этот файл в .deploy.env и заполни.
#   cp .deploy.env.example .deploy.env && chmod 600 .deploy.env
# .deploy.env в .gitignore — реальные креды НЕ попадают в git.

# Протокол: ftp или sftp (бери тот, что указан в письме reg.ru).
DEPLOY_PROTOCOL=ftp

# FTP-хост из письма reg.ru (например, ftp.example.ru или server123.hosting.reg.ru).
DEPLOY_HOST=

# Порт: оставь пустым для стандартного (21 для ftp, 22 для sftp).
DEPLOY_PORT=

# FTP-логин (например, u1234567).
DEPLOY_USER=

# FTP-пароль.
DEPLOY_PASS=

# Папка сайта на хостинге. На reg.ru shared обычно /<имя_домена>/docs или /<имя_домena>/public_html.
# Точный путь видно при заходе FTP-клиентом или в файловом менеджере панели reg.ru.
# Если не уверен — прогони сначала ./deploy.sh --dry-run и проверь, куда целится.
DEPLOY_REMOTE_DIR=

# FTPS (шифрование для протокола ftp): true, если хостинг поддерживает; иначе false.
FTP_SSL=true
